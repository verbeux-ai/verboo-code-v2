{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verboo Code",
  "version": "0.2.2-alpha.18",
  "identifier": "ai.verbeux.verboo-code",
  "build": {
    "frontendDist": "../tauri/ui",
    "additionalWatchFolders": [
      "../tauri/bridge.js",
      "../tauri/host.mjs"
    ]
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../.desktop-build/tauri/runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1OEE2NkVGNjdGN0VGRkQKUldUOTcvZG43MmFLOWVweVY1dzN3THgxSVFuN2UvYSs1UnljQkVDd0lFT2NEZTNNQ0JjZUJkMGoK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://raw.githubusercontent.com/verbeux-ai/verboo-code-v2/update-feed/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
